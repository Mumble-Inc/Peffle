{
  "name": "razorflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-native-deps.mjs",
    "dev": "bash scripts/with-supported-node.sh next dev --port 3010",
    "build": "bash scripts/with-supported-node.sh sh -c 'prisma generate && node --require ./scripts/readlink-shim.cjs ./node_modules/next/dist/bin/next build --webpack'",
    "start": "bash scripts/with-supported-node.sh next start --port 3010",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "smoke:gemini-intent": "tsx scripts/smoke-gemini-intent.ts",
    "validate:gemini-discovery": "tsx scripts/validate-gemini-discovery.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "catalog:images": "tsx scripts/generate-northline-product-images.ts",
    "redteam": "NODE_ENV=test RAZORFLOW_REDTEAM=1 tsx scripts/redteam.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "sync:ai-env": "node scripts/sync-ai-env-from-blueprint.mjs",
    "verify:clean": "bash scripts/verify-clean.sh",
    "screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/peffle-screenshots.spec.ts --project=chromium"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "nodemailer": "^9.0.6",
    "peffle": "0.1.7",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
