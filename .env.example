DATABASE_URL=postgresql://razorflow:razorflow@localhost:5432/razorflow

DEMO_MERCHANT_ID=northline-audio

# Playwright loads .env and .env.local before starting the dev server so E2E
# Razorpay detection matches the application. Omit keys locally to exercise the
# unconfigured checkout failure path; set Test Mode keys to exercise real checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Phase 3B: LLM intent extraction (server-side only; never expose to the client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 3D: signed buyer/merchant session tokens (server-side only)
RAZORFLOW_SESSION_SECRET=

# Phase 12: SMTP email verification (server-side only; never expose to the browser)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 12: bootstrap administrator (must verify email normally; not a domain rule)
INITIAL_ADMIN_EMAIL=

# Peffle execution guard (server-only local SQLite; not a payment secret)
# Amounts and budget limits are integer paise.
PEFFLE_STORAGE=.peffle/ledger.db
PEFFLE_POLICY=peffle.policy.json
# Optional override of the checkout.create daily cap in peffle.policy.json (paise)
# Default policy cap is 1000000 paise (₹10,000 / UTC day)
# PEFFLE_CHECKOUT_CAP_PAISE=1000000
# Optional override of the apply_discount daily cap (paise). Policy default 500000.
# PEFFLE_DISCOUNT_CAP_PAISE=50000
# Test-only: PEFFLE_GUARD=0 skips peffle.guard wrapping (commerce still runs).
# NODE_ENV must be test or the process throws at startup. Never set this in production.

# Presentation operator view. Requires a staff/admin session. Never enable for public buyers.
# DEMO_MODE=1

